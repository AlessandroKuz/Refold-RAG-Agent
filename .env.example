# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Ollama Models & Connection
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gpt-oss
OLLAMA_EMBEDDING_MODEL=qwen3-embedding

# OpenWebUI Integration
OPENWEBUI_MODEL_NAME=refold-agent

# File & Storage Paths
RESOURCES_DIR=resources
DATA_DIR=data
CHROMA_DIR=data/chroma
SQLITE_DB_PATH=data/chat.db

# RAG Hyperparameters
TOP_K=8
SIMILARITY_THRESHOLD=0.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
